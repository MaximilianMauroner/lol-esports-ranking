# Optional. Without these, the app runs honestly labeled fixture/demo data.
DATABASE_URL=postgresql://user:password@host:5432/database
RIOT_API_KEY=RGAPI-your-development-or-production-key

# Required for archive-backed ingestion. Set these to the private DPS archive bucket.
# Generic ranking bucket variables are never used for DPS archives.
DPS_ARCHIVE_BUCKET=private-archive-bucket
DPS_ARCHIVE_ENDPOINT=https://s3.example.invalid
DPS_ARCHIVE_REGION=ams
DPS_ARCHIVE_ACCESS_KEY_ID=replace-locally
DPS_ARCHIVE_SECRET_ACCESS_KEY=replace-locally
ARCHIVE_REQUIRED=true

# Bounded ingestion safety controls (defaults are conservative; never disable archive-first).
INGEST_MAX_ACCEPTED_MATCHES=200
INGEST_MAX_REQUESTS=5000
INGEST_MAX_BUCKET_BYTES=268435456
INGEST_MAX_PROJECTED_PG_BYTES=67108864
RIOT_REQUEST_TIMEOUT_MS=20000
STATIC_REQUEST_TIMEOUT_MS=20000

# Required for the private prototype deployment. Keep these out of git and browser code.
PROTOTYPE_ACCESS_PASSWORD=generate-a-long-random-password
PROTOTYPE_SESSION_SECRET=generate-a-long-random-hmac-secret

# Enable only behind a trusted proxy that overwrites or appends the client IP in X-Forwarded-For.
DPS_TRUST_PROXY=false

# Pinned application data version. Patch 26.18 maps to Data Dragon 16.18.1.
LOL_PATCH=26.18
DDRAGON_VERSION=16.18.1
