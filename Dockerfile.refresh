# Build the Rust worker independently of the Node web service.
FROM rust:1.98-slim-bookworm AS build
WORKDIR /app
COPY worker ./worker
RUN cargo build --manifest-path worker/Cargo.toml --release --locked --package ranking-refresh --jobs 2

FROM debian:bookworm-slim
RUN apt-get update && apt-get install --no-install-recommends -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/worker/target/release/ranking-refresh /usr/local/bin/ranking-refresh
COPY worker/THIRD_PARTY_NOTICES.md /usr/local/share/ranking-refresh/THIRD_PARTY_NOTICES.md
ENTRYPOINT ["ranking-refresh"]
CMD ["contracts"]
